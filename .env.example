# NutrionApp — variables d'environnement (exemple). JAMAIS de valeur prod ici.

NODE_ENV=development
# Ce qui diffère d'un environnement à l'autre : development | preprod | production.
# Environnement Sentry et PostHog, bandeau de préprod, garde-fous du seed et des tests.
# Jamais NODE_ENV pour distinguer préprod et prod : il vaut `production` dans les images.
APP_ENV=development
# Web : figé au build (cd.yml, build-arg). Mobile : EXPO_PUBLIC_APP_ENV, posé par eas.json.
NEXT_PUBLIC_APP_ENV=development

# Port de la route de santé du process cron (interne au conteneur en préprod).
CRON_HEALTH_PORT=3100
# Niveau des journaux Pino (fatal | error | warn | info | debug | trace).
LOG_LEVEL=info

# Base de données (postgresql)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nutrion-app

# Cache / Queue
REDIS_URL=redis://localhost:6379

# Auth (better-auth)
BETTER_AUTH_SECRET=dev-change-me
BETTER_AUTH_URL=http://localhost:3001

# Mailer (brevo (Mailpit en dev) = Brevo)
BREVO_API_KEY=xkeysib-dev-placeholder

# Stockage objet (scaleway-s3 (s3mock en dev) = Scaleway S3 ; adobe/s3mock en dev local, service s3
# du compose : seau créé au démarrage, tout identifiant accepté, style chemin)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nutrion-app-dev
S3_ACCESS_KEY=dev
S3_SECRET_KEY=devsecret

# Observabilité (toujours). Sans DSN, Sentry ne s'initialise pas (dev local).
# DSN de la région UE (ingest.de.sentry.io), jamais un DSN américain.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
# Version déployée (tag sha-<hexa> de l'image), figée dans l'image par cd.yml : release Sentry.
RELEASE=local
# Plafond d'événements Sentry par jour et par process (quota mensuel commun à l'organisation).
# SENTRY_DAILY_EVENT_BUDGET=150
# Envoi des sourcemaps (build web, build mobile local) : jamais ici, l'environnement du
# poste ou le secret de build de la CI. SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN.
# Doc d'API (/docs Scalar, /swagger, /openapi.json) : true en dev et en préprod.
EXPOSE_API_DOCS=true
# Requêtes par minute et par IP (throttler global). 100 par défaut, plafond en production.
# Relevé pour un passage k6 local (apps/load-tests), dont tous les VUs partagent une adresse.
# THROTTLE_LIMIT=100
# PostHog, instance UE : l'ingestion passe par eu.i.posthog.com (eu.posthog.com est
# l'interface). Clé du projet figée au build : web (cd.yml, build-arg), mobile (poste de
# build). Rien n'est envoyé avant le consentement de l'usager. Un tenant peut fournir la sienne.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Paiement (none) — présent seulement si PSP != none
# none_API_KEY=

# Transport (false) — présent seulement si transport
# OTP_URL=
