{
  "name": "@nutrion/backend",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:cron": "node dist/modules/cron/main.js",
    "db:migrate": "MIGRATIONS_DIR=../../packages/db-schema/migrations tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "seed": "tsx src/seed/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@better-auth/expo": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@nutrion/db": "workspace:*",
    "@nutrion/db-schema": "workspace:*",
    "@nutrion/sentry": "workspace:*",
    "@scalar/nestjs-api-reference": "catalog:",
    "better-auth": "catalog:",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "fflate": "^0.8.3",
    "ioredis": "catalog:",
    "nestjs-pino": "catalog:",
    "nestjs-zod": "catalog:",
    "nodemailer": "^10.3.1",
    "pino": "catalog:",
    "postgres": "catalog:",
    "sanitize-html": "^2.18.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/utils": "^0.5.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "catalog:",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
