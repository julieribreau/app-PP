{
  "name": "@nutrion/mobile",
  "private": true,
  "//": "Mobile = TOUJOURS Expo / React Native (SDK 58). Tests : Vitest pour la logique (*.test.ts), jest-expo et @testing-library/react-native pour les composants (*.test.tsx). Versions natives fixées par le SDK (`expo install --check`). Exclus du contrôle : AsyncStorage en 3 (le SDK annonce 2.2) et @sentry/react-native en dernière 8 (le SDK annonce ~8.28), même couple que les autres dépôts Bullify.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --ci --passWithNoTests && vitest run"
  },
