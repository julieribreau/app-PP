enum product_status {
  draft
  active
  archived
}

table account {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  account_id text [not null]
  provider_id text [not null]
  user_id uuid [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at "timestamp with time zone"
  refresh_token_expires_at "timestamp with time zone"
  scope text
  password text
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    user_id [name: 'account_user_id_idx']
  }
}

table session {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  expires_at "timestamp with time zone" [not null]
  token text [not null, unique]
  ip_address text
  user_agent text
  user_id uuid [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    user_id [name: 'session_user_id_idx']
  }
}

table two_factor {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  secret text [not null]
  backup_codes text [not null]
  user_id uuid [not null]
  verified boolean [default: true]
  failed_verification_count integer [default: 0]
  locked_until "timestamp with time zone"

  indexes {
    user_id [name: 'two_factor_user_id_idx']
    secret [name: 'two_factor_secret_idx']
  }
}

table user {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name text [not null]
  email text [not null, unique]
  email_verified boolean [not null, default: false]
  image text
  first_name text
  last_name text
  phone text
  locale text [not null, default: 'fr']
  theme text [not null, default: 'system']
  role text [not null, default: 'user']
  two_factor_enabled boolean [not null, default: false]
  suspended_at "timestamp with time zone"
  suspended_reason text
  suspended_by uuid
  anonymized_at "timestamp with time zone"
  failed_login_attempts integer [not null, default: 0]
  locked_until "timestamp with time zone"
  last_login_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    created_at [name: 'user_created_at_idx']
  }
}

table verification {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  identifier text [not null]
  value text [not null]
  expires_at "timestamp with time zone" [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    identifier [name: 'verification_identifier_idx']
  }
}

table permission {
  key text [pk, not null]
  module text [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
}

table role {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  key text [not null, unique]
  name text [not null]
  description text
  is_system boolean [not null, default: false]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

table role_permission {
  role_id uuid [not null]
  permission_key text [not null]

  indexes {
    (role_id, permission_key) [pk]
  }
}

table user_role {
  user_id uuid [not null]
  role_id uuid [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (user_id, role_id) [pk]
  }
}

table address {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  label text
  recipient_name text [not null]
  line1 text [not null]
  line2 text
  postal_code text [not null]
  city text [not null]
  country_code text [not null, default: 'FR']
  phone text
  is_default boolean [not null, default: false]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    user_id [name: 'address_user_id_idx']
  }
}

table audit_log {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  actor_user_id uuid
  action text [not null]
  target_type text [not null]
  target_id text
  diff jsonb
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (target_type, target_id, created_at) [name: 'audit_log_target_idx']
    (actor_user_id, created_at) [name: 'audit_log_actor_idx']
  }
}

table category {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  slug text [not null, unique]
  name jsonb [not null]
  position integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

table product {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  slug text [not null, unique]
  category_id uuid
  name jsonb [not null]
  summary jsonb [not null, default: `{"fr":""}`]
  description jsonb [not null]
  image_key text
  price_cents integer [not null]
  vat_rate_bps integer [not null, default: 550]
  status product_status [not null, default: 'draft']
  position integer [not null, default: 0]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (category_id, status) [name: 'product_category_idx']
  }
}

table product_option {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  product_id uuid [not null]
  name jsonb [not null]
  position integer [not null, default: 0]
}

table product_option_value {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  option_id uuid [not null]
  label jsonb [not null]
  position integer [not null, default: 0]
}

table product_variant {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  product_id uuid [not null]
  option_values jsonb [not null]
  combination_key text [not null]
  sku text [unique]
  price_cents integer
  stock integer
  is_active boolean [not null, default: true]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (product_id, combination_key) [name: 'product_variant_combination_uq', unique]
  }
}

table cart {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid
  guest_token_hash text
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    user_id [name: 'cart_user_uq', unique]
    guest_token_hash [name: 'cart_guest_uq', unique]
    
    updated_at [name: 'cart_updated_at_idx']
  }
}

table cart_item {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  cart_id uuid [not null]
  variant_id uuid [not null]
  quantity integer [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (cart_id, variant_id) [name: 'cart_item_variant_uq', unique]
    
  }
}

ref account_user_id_user_id_fk: account.user_id > user.id [delete: cascade, update: no action]

ref session_user_id_user_id_fk: session.user_id > user.id [delete: cascade, update: no action]

ref two_factor_user_id_user_id_fk: two_factor.user_id > user.id [delete: cascade, update: no action]

ref role_permission_role_id_role_id_fk: role_permission.role_id > role.id [delete: cascade, update: no action]

ref role_permission_permission_key_permission_key_fk: role_permission.permission_key > permission.key [delete: cascade, update: no action]

ref user_role_user_id_user_id_fk: user_role.user_id > user.id [delete: cascade, update: no action]

ref user_role_role_id_role_id_fk: user_role.role_id > role.id [delete: cascade, update: no action]

ref address_user_id_user_id_fk: address.user_id > user.id [delete: cascade, update: no action]

ref audit_log_actor_user_id_user_id_fk: audit_log.actor_user_id > user.id [delete: set null, update: no action]

ref product_category_id_category_id_fk: product.category_id > category.id [delete: set null, update: no action]

ref product_option_product_id_product_id_fk: product_option.product_id > product.id [delete: cascade, update: no action]

ref product_option_value_option_id_product_option_id_fk: product_option_value.option_id > product_option.id [delete: cascade, update: no action]

ref product_variant_product_id_product_id_fk: product_variant.product_id > product.id [delete: cascade, update: no action]

ref cart_user_id_user_id_fk: cart.user_id > user.id [delete: cascade, update: no action]

ref cart_item_cart_id_cart_id_fk: cart_item.cart_id > cart.id [delete: cascade, update: no action]

ref cart_item_variant_id_product_variant_id_fk: cart_item.variant_id > product_variant.id [delete: cascade, update: no action]