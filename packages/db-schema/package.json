{
  "name": "@nutrion/db-schema",
  "version": "0.0.0",
  "private": true,
  "//": "Les migrations s'appliquent par apps/backend (src/migrate.ts) : le même code en dev et dans l'image.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:dbml": "tsx src/dbml.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "drizzle-dbml-generator": "^0.10.0",
    "drizzle-kit": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
